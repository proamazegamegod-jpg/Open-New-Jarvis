{
  "name": "mini-jarvis",
  "version": "1.0.0",
  "private": true,
  "description": "Voice-first desktop workflows with a separate landing page and Electron app UI.",
  "author": "proamazegamegod-jpg",
  "main": "src/main/index.js",
  "scripts": {
    "postinstall": "electron-rebuild -f -w uiohook-napi",
    "test": "node --test",
    "build": "cross-env BUILD_TARGET=web vite build",
    "build:electron": "cross-env BUILD_TARGET=electron vite build",
    "package": "npm run build:electron && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "dist": "npm run build:electron && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "renderer": "cross-env NODE_ENV=development vite",
    "electron": "cross-env NODE_ENV=development wait-on http://localhost:5173 && electron .",
    "stt": "powershell -ExecutionPolicy Bypass -File .\\scripts\\stt-runner.ps1",
    "stt:mock": "powershell -ExecutionPolicy Bypass -File .\\scripts\\stt-runner.ps1 --mock",
    "dev": "concurrently \"npm:renderer\" \"npm:electron\"",
    "start": "npm run dev",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.17.0",
    "uiohook-napi": "^1.5.4",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.2",
    "wait-on": "^7.2.0"
  }
}
