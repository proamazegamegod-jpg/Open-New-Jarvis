{
  "name": "mini-jarvis",
  "version": "0.1.0",
  "private": true,
  "main": "src/main/index.js",
  "scripts": {
    "build": "cross-env BUILD_TARGET=web vite build",
    "build:electron": "cross-env BUILD_TARGET=electron vite build",
    "renderer": "cross-env NODE_ENV=development vite",
    "electron": "cross-env NODE_ENV=development wait-on http://localhost:5173 && electron .",
    "stt": "node .\\scripts\\stt-server-placeholder.js",
    "dev": "concurrently \"npm:renderer\" \"npm:stt\" \"npm:electron\"",
    "start": "npm run dev",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "electron": "^30.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "vite": "^5.4.2",
    "wait-on": "^7.2.0"
  }
}
